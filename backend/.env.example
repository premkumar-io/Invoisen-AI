# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5050

# ── Database ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/Invoisen

# ── JWT ───────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_minimum_32_chars_required_here
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_minimum_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URL ──────────────────────────────────────────────────────────
# Production: https://invoisen.vercel.app | Local: http://localhost:3050
CLIENT_URL=https://invoisen.vercel.app

# ── CORS (comma-separated) ────────────────────────────────────────────────
CORS_ORIGINS=https://invoisen.vercel.app,http://localhost:3050,http://localhost:3000,http://localhost:5173

# ── Google OAuth (optional) ──────────────────────────────────────────────────
# Obtain credentials from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Set Authorized JS origins: https://invoisen.vercel.app, http://localhost:3050
# Set Authorized redirect URI: https://invoisen-api.onrender.com/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://invoisen-api.onrender.com/api/v1/auth/google/callback

# ── Email (Nodemailer) — optional in development ────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@Invoisen.com

# ── Invoice limits ────────────────────────────────────────────────────────
FREE_PLAN_MONTHLY_INVOICE_LIMIT=10
TRASH_RETENTION_DAYS=30

# ── Admin seed (optional) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@Invoisen.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Invoisen Admin

# ── PDF (optional) ──────────────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=

# ── Gemini AI ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── WhatsApp Provider (meta | twilio | mock) ─────────────────────────────
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_NAME=

# Twilio WhatsApp credentials (if WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── Cloudinary Image & File Storage (optional — free tier) ───────────────
# Register free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


